   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# CheXpert Results Analysis\n",
    "Comprehensive analysis of model performance and visualizations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import torch\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "import sys\n",
    "sys.path.append(\"..\")\n",
    "\n",
    "from evaluation.metrics import ClassificationMetrics, SegmentationMetrics\n",
    "from evaluation.visualization import GradCAMPlus, AttentionVisualizer\n",
    "from evaluation.interpretability import ShapAnalyzer, LIMEExplainer"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load Results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "results_path = Path(\"../results\")\n",
    "predictions = torch.load(results_path / \"predictions.pt\")\n",
    "true_labels = torch.load(results_path / \"true_labels.pt\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Performance Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "metrics = ClassificationMetrics()\n",
    "metrics.update(predictions, true_labels)\n",
    "results = metrics.compute_metrics()\n",
    "\n",
    "print(\"Classification Results:\")\n",
    "for metric, value in results.items():\n",
    "    print(f\"{metric}: {value:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Plot confusion matrix\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(results[\"confusion_matrix\"], annot=True, fmt=\"d\")\n",
    "plt.title(\"Confusion Matrix\")\n",
    "plt.xlabel(\"Predicted\")\n",
    "plt.ylabel(\"True\")\n",
    "plt.show()\n",
    "\n",
    "# Plot ROC curves\n",
    "plt.figure(figsize=(10, 8))\n",
    "for i, (fpr, tpr) in enumerate(zip(results[\"fpr\"], results[\"tpr\"])):\n",
    "    plt.plot(fpr, tpr, label=f\"Class {i}\")\n",
    "plt.plot([0, 1], [0, 1], \"k--\")\n",
    "plt.xlabel(\"False Positive Rate\")\n",
    "plt.ylabel(\"True Positive Rate\")\n",
    "plt.title(\"ROC Curves\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
 ],
